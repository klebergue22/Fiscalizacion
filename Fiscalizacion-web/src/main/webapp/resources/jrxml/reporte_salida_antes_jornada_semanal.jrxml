<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reporte_salida_antes_jornada_semanal" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="b085f143-9f1c-4470-a0f2-87331d49b52b">
	<parameter name="pathImagen" class="java.lang.String"/>
	<parameter name="FechaDesde" class="java.lang.String"/>
	<parameter name="FechaHasta" class="java.lang.String"/>
	<parameter name="NoGestion" class="java.lang.Short"/>
	<parameter name="Codigo" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT q.codigo,
       q.nombre_c,
       q.area_descrip,
       q.fecha,
       q.dia_semana,
       q.hora_fin_jornada,
       q.ultimo_timbre,
       q.minutos_antes_salida,
       q.detalle_timbres,
       q.detalle_permisos
  FROM (
        SELECT em.codigo,
               em.nombre_c,
               ar.descrip AS area_descrip,
               cal.fecha,
               cal.dia_semana,
               '16:30' AS hora_fin_jornada,
               (
                 SELECT MAX(LPAD(r.hora, 2, '0') || ':' || LPAD(r.minuto, 2, '0'))
                   FROM rh.reloj r
                  WHERE r.codigo = em.codigo
                    AND r.fecha = cal.fecha
               ) AS ultimo_timbre,
               (
                 SELECT CASE
                          WHEN MAX(r.hora * 60 + r.minuto) IS NULL THEN NULL
                          WHEN MAX(r.hora * 60 + r.minuto) < 990 THEN 990 - MAX(r.hora * 60 + r.minuto)
                          ELSE 0
                        END
                   FROM rh.reloj r
                  WHERE r.codigo = em.codigo
                    AND r.fecha = cal.fecha
               ) AS minutos_antes_salida,
               NVL((
                 SELECT LISTAGG(
                          LPAD(r.hora, 2, '0') || ':' || LPAD(r.minuto, 2, '0') || '-' ||
                          CASE
                            WHEN UPPER(r.archivo) LIKE '%TELETIMBRADO%' THEN 'T'
                            WHEN UPPER(r.archivo) LIKE '%VIRTUAL%' THEN 'G'
                            ELSE 'B'
                          END,
                          ' | '
                        ) WITHIN GROUP (ORDER BY r.fecha, r.hora, r.minuto)
                   FROM rh.reloj r
                  WHERE r.codigo = em.codigo
                    AND r.fecha = cal.fecha
               ), 'SIN TIMBRE') AS detalle_timbres,
               NVL((
                 SELECT LISTAGG(
                          v.descrip ||
                          CASE
                            WHEN TRUNC(v.f_inico) = TRUNC(NVL(v.f_finalizacion, v.f_inico)) THEN
                              ' [' || TO_CHAR(v.f_inico, 'HH24:MI') || ' - ' ||
                              TO_CHAR(NVL(v.f_finalizacion, v.f_inico), 'HH24:MI') || ']'
                            ELSE
                              ' [' || TO_CHAR(v.f_inico, 'DD/MM/YYYY HH24:MI') || ' - ' ||
                              TO_CHAR(NVL(v.f_finalizacion, v.f_inico), 'DD/MM/YYYY HH24:MI') || ']'
                          END,
                          ' | '
                        ) WITHIN GROUP (ORDER BY v.f_inico)
                   FROM permisos.v_permisos_empleado v
                  WHERE v.no_persona = em.no_persona
                    AND cal.fecha BETWEEN TRUNC(v.f_inico) AND TRUNC(NVL(v.f_finalizacion, v.f_inico))
               ), '-') AS detalle_permisos
          FROM (
                SELECT e.no_persona,
                       e.nombre_c,
                       e.codigo,
                       e.email_institucional,
                       c.no_cd
                  FROM rh.t_dat_empleado e
                  JOIN rh.t_contrataciones c ON e.no_persona = c.no_persona
                 WHERE c.estado = 'V'
                   AND INSTR(e.email_institucional, '@geograficomilitar.gob.ec') > 0
                   AND ($P{NoGestion} IS NULL OR c.no_cd = $P{NoGestion})
                   AND ($P{Codigo} IS NULL OR e.codigo = $P{Codigo})
               ) em
          LEFT JOIN inventarios.t_areas ar ON ar.no_cd = em.no_cd
          CROSS JOIN (
                SELECT TRUNC(TO_DATE($P{FechaDesde}, 'DD/MM/YYYY')) + LEVEL - 1 AS fecha,
                       TRIM(TO_CHAR(TRUNC(TO_DATE($P{FechaDesde}, 'DD/MM/YYYY')) + LEVEL - 1, 'DAY', 'NLS_DATE_LANGUAGE=SPANISH')) AS dia_semana
                  FROM dual
               CONNECT BY LEVEL <= TRUNC(TO_DATE($P{FechaHasta}, 'DD/MM/YYYY')) - TRUNC(TO_DATE($P{FechaDesde}, 'DD/MM/YYYY')) + 1
               ) cal
       ) q
 WHERE q.minutos_antes_salida > 0
 ORDER BY q.area_descrip, q.nombre_c, q.fecha]]>
	</queryString>
	<field name="CODIGO" class="java.lang.String"/>
	<field name="NOMBRE_C" class="java.lang.String"/>
	<field name="AREA_DESCRIP" class="java.lang.String"/>
	<field name="FECHA" class="java.sql.Timestamp"/>
	<field name="DIA_SEMANA" class="java.lang.String"/>
	<field name="HORA_FIN_JORNADA" class="java.lang.String"/>
	<field name="ULTIMO_TIMBRE" class="java.lang.String"/>
	<field name="MINUTOS_ANTES_SALIDA" class="java.math.BigDecimal"/>
	<field name="DETALLE_TIMBRES" class="java.lang.String"/>
	<field name="DETALLE_PERMISOS" class="java.lang.String"/>
