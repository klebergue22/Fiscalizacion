<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reporte_jornada_laboral_mensual" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="5f7e1a8b-9c4d-47ab-a1b2-0c0e71a0a901">
	<parameter name="pathImagen" class="java.lang.String"/>
	<parameter name="FechaDesde" class="java.lang.String"/>
	<parameter name="FechaHasta" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT q.codigo,
       q.servidor,
       q.correo_institucional,
       q.area,
       q.responsable_area,
       q.fecha,
       q.dia,
       'NO TIMBRA SALIDA' AS estado_jornada,
       q.tipo_jornada,
       q.horario_jornada,
       q.ultimo_timbre AS horario_almuerzo,
       NULL AS minutos_almuerzo,
       TO_CHAR(q.min_ultimo_timbre_hasta_salida) AS vigencia_jornada,
       CASE
         WHEN q.detalle_permisos <> '-' THEN 'PERMISO: ' || q.detalle_permisos || ' | TIMBRES: ' || q.detalle_timbres
         ELSE 'TIMBRES: ' || q.detalle_timbres
       END AS observacion
  FROM (
        SELECT TO_CHAR(em.codigo) AS codigo,
               em.nombre_c AS servidor,
               em.email_institucional AS correo_institucional,
               NVL(ar.descrip, 'SIN AREA') AS area,
               NVL(resp.pie_firma, resp.nombre_c) AS responsable_area,
               cal.fecha AS fecha,
               cal.dia_semana AS dia,
               CASE
                 WHEN t.codigo IS NOT NULL THEN
                   CASE WHEN t.h_desde >= 18 OR t.h_hasta < 6 THEN 'TURNO NOCTURNO' ELSE 'TURNO DIURNO' END
                 WHEN ha.no_cd IS NOT NULL THEN 'HORARIO GENERAL'
                 ELSE 'HORARIO DEFAULT'
               END AS tipo_jornada,
               CASE
                 WHEN t.codigo IS NOT NULL THEN
                   LPAD(t.h_desde, 2, '0') || ':' || LPAD(t.mi_desde, 2, '0') || ' - ' ||
                   LPAD(t.h_hasta, 2, '0') || ':' || LPAD(t.mi_hasta, 2, '0')
                 ELSE
                   LPAD(TRUNC(NVL(ha.hora_inicio, 450) / 60), 2, '0') || ':' || LPAD(MOD(NVL(ha.hora_inicio, 450), 60), 2, '0') || ' - ' ||
                   LPAD(TRUNC(NVL(ha.hora_fin, 990) / 60), 2, '0') || ':' || LPAD(MOD(NVL(ha.hora_fin, 990), 60), 2, '0')
               END AS horario_jornada,
               NVL(
                 (
                   SELECT LISTAGG(LPAD(r.hora, 2, '0') || ':' || LPAD(r.minuto, 2, '0'), ' | ')
                          WITHIN GROUP (ORDER BY r.fecha, r.hora, r.minuto)
                     FROM rh.reloj r
                    WHERE r.codigo = em.codigo
                      AND (
                           r.fecha = cal.fecha
                           OR (t.codigo IS NOT NULL AND t.h_hasta < 12 AND r.fecha = cal.fecha + 1)
                          )
                 ),
                 '-'
               ) AS detalle_timbres,
               NVL(
                 (
                   SELECT LISTAGG(
                            v.descrip ||
                            CASE
                              WHEN TRUNC(v.f_inico) = TRUNC(NVL(v.f_finalizacion, v.f_inico))
                                THEN ' [' || TO_CHAR(v.f_inico, 'HH24:MI') || ' - ' || TO_CHAR(NVL(v.f_finalizacion, v.f_inico), 'HH24:MI') || ']'
                              ELSE ' [' || TO_CHAR(v.f_inico, 'DD/MM/YYYY HH24:MI') || ' - ' || TO_CHAR(NVL(v.f_finalizacion, v.f_inico), 'DD/MM/YYYY HH24:MI') || ']'
                            END,
                            ' | '
                          ) WITHIN GROUP (ORDER BY v.f_inico)
                     FROM permisos.v_permisos_empleado v
                    WHERE v.no_persona = em.no_persona
                      AND cal.fecha BETWEEN TRUNC(v.f_inico) AND TRUNC(NVL(v.f_finalizacion, v.f_inico))
                 ),
                 '-'
               ) AS detalle_permisos,
               (
                 SELECT MAX(LPAD(r2.hora, 2, '0') || ':' || LPAD(r2.minuto, 2, '0'))
                   FROM rh.reloj r2
                  WHERE r2.codigo = em.codigo
                    AND r2.fecha =
                        CASE
                          WHEN t.codigo IS NOT NULL AND t.h_hasta < 12 THEN cal.fecha + 1
                          ELSE cal.fecha
                        END
               ) AS ultimo_timbre,
               (
                 SELECT CASE
                          WHEN MAX(r3.hora * 60 + r3.minuto) IS NULL THEN NULL
                          WHEN MAX(r3.hora * 60 + r3.minuto) < 
                               CASE
                                 WHEN t.codigo IS NOT NULL THEN (t.h_hasta * 60 + t.mi_hasta)
                                 ELSE NVL(ha.hora_fin, 990)
                               END
                            THEN CASE
                                   WHEN t.codigo IS NOT NULL THEN (t.h_hasta * 60 + t.mi_hasta)
                                   ELSE NVL(ha.hora_fin, 990)
                                 END - MAX(r3.hora * 60 + r3.minuto)
                          ELSE 0
                        END
                   FROM rh.reloj r3
                  WHERE r3.codigo = em.codigo
                    AND r3.fecha =
                        CASE
                          WHEN t.codigo IS NOT NULL AND t.h_hasta < 12 THEN cal.fecha + 1
                          ELSE cal.fecha
                        END
               ) AS min_ultimo_timbre_hasta_salida
          FROM (
                SELECT e.no_persona,
                       e.nombre_c,
                       e.codigo,
                       e.email_institucional,
                       c.no_cd
                  FROM rh.t_dat_empleado e
                  JOIN rh.t_contrataciones c ON e.no_persona = c.no_persona
                 WHERE c.estado = 'V'
                   AND INSTR(e.email_institucional, '@geograficomilitar.gob.ec') > 0
               ) em
          LEFT JOIN inventarios.t_areas ar ON ar.no_cd = em.no_cd
          LEFT JOIN rh.t_dat_empleado resp ON resp.no_persona = ar.responsable_no_persona
          CROSS JOIN (
                SELECT TRUNC(TO_DATE($P{FechaDesde}, 'DD/MM/YYYY')) + LEVEL - 1 AS fecha,
                       TRIM(TO_CHAR(TRUNC(TO_DATE($P{FechaDesde}, 'DD/MM/YYYY')) + LEVEL - 1, 'DAY', 'NLS_DATE_LANGUAGE=SPANISH')) AS dia_semana
                  FROM dual
               CONNECT BY LEVEL <= TRUNC(TO_DATE($P{FechaHasta}, 'DD/MM/YYYY')) - TRUNC(TO_DATE($P{FechaDesde}, 'DD/MM/YYYY')) + 1
               ) cal
          LEFT JOIN rh.turnos t
            ON t.codigo = em.codigo
           AND cal.fecha BETWEEN t.f_desde AND t.f_hasta
          LEFT JOIN rh.horario_almuerzo ha
            ON ha.no_cd = em.no_cd
           AND (ha.dia_semana IS NULL OR UPPER(TRIM(ha.dia_semana)) = UPPER(TRIM(cal.dia_semana)))
           AND ha.activo = 'S'
           AND (ha.fecha_desde IS NULL OR cal.fecha >= ha.fecha_desde)
           AND (ha.fecha_hasta IS NULL OR cal.fecha <= ha.fecha_hasta)
         WHERE (
                 t.codigo IS NOT NULL
                 OR TO_CHAR(cal.fecha, 'DY', 'NLS_DATE_LANGUAGE=ENGLISH') NOT IN ('SAT', 'SUN')
               )
       ) q
 WHERE q.min_ultimo_timbre_hasta_salida > 0
   AND NOT (
       (
           UPPER(q.detalle_permisos) LIKE '%PERSONAL%'
           OR UPPER(q.detalle_permisos) LIKE '%ATENCION MEDICA%'
       )
       AND q.detalle_permisos LIKE '%- 16:30]%'
   )
 ORDER BY q.area, q.servidor, q.fecha]]>
	</queryString>
	<field name="CODIGO" class="java.lang.String"/>
	<field name="SERVIDOR" class="java.lang.String"/>
	<field name="CORREO_INSTITUCIONAL" class="java.lang.String"/>
	<field name="AREA" class="java.lang.String"/>
	<field name="RESPONSABLE_AREA" class="java.lang.String"/>
	<field name="FECHA" class="java.sql.Timestamp"/>
	<field name="DIA" class="java.lang.String"/>
	<field name="ESTADO_JORNADA" class="java.lang.String"/>
	<field name="TIPO_JORNADA" class="java.lang.String"/>
	<field name="HORARIO_JORNADA" class="java.lang.String"/>
	<field name="HORARIO_ALMUERZO" class="java.lang.String"/>
	<field name="MINUTOS_ALMUERZO" class="java.math.BigDecimal"/>
	<field name="VIGENCIA_JORNADA" class="java.lang.String"/>
	<field name="OBSERVACION" class="java.lang.String"/>
