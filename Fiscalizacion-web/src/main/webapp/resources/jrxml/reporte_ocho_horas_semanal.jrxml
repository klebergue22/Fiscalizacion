			<staticText><reportElement x="515" y="4" width="125" height="15" uuid="93b189d1-34fc-48da-9fd5-064eeaaf217c"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[DETALLE_PERMISOS]]></text></staticText>
