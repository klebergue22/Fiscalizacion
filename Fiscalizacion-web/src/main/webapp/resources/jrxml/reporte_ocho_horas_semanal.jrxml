	<detail>
		<band height="34">
			<textField><reportElement x="0" y="0" width="45" height="14" uuid="ed7b4f24-2381-4948-9d39-2e9d3a6f9298"/><textElement textAlignment="Center"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{CODIGO}]]></textFieldExpression></textField>
			<textField isStretchWithOverflow="true"><reportElement x="47" y="0" width="150" height="30" uuid="b12f4234-f657-49ee-8cb5-a9e12ad3a3c0"/><textElement><font size="6"/></textElement><textFieldExpression><![CDATA[$F{NOMBRE_C}]]></textFieldExpression></textField>
			<textField isStretchWithOverflow="true"><reportElement x="199" y="0" width="190" height="30" uuid="4f46083f-b2e0-4eb7-a7db-df21f610ec04"/><textElement><font size="6"/></textElement><textFieldExpression><![CDATA[$F{AREA_DESCRIP}]]></textFieldExpression></textField>
			<textField pattern="dd/MM/yyyy"><reportElement x="391" y="0" width="55" height="14" uuid="ab56237a-e55f-4f84-ac32-d3adad6ee543"/><textElement textAlignment="Center"><font size="6"/></textElement><textFieldExpression><![CDATA[$F{FECHA}]]></textFieldExpression></textField>
			<textField><reportElement x="448" y="0" width="65" height="14" uuid="2de568df-b6f0-4725-b7cc-744523f4de5f"/><textElement textAlignment="Center"><font size="6"/></textElement><textFieldExpression><![CDATA[$F{DIA_SEMANA}]]></textFieldExpression></textField>
			<textField isStretchWithOverflow="true"><reportElement x="515" y="0" width="125" height="30" uuid="9a68f3eb-c05d-441e-8512-9159a7adee3a"/><textElement><font size="6"/></textElement><textFieldExpression><![CDATA[$F{DETALLE_PERMISOS}]]></textFieldExpression></textField>
			<textField isStretchWithOverflow="true"><reportElement x="642" y="0" width="120" height="30" uuid="314a98b8-83b0-4f1b-87bb-d94717598df0"/><textElement><font size="6"/></textElement><textFieldExpression><![CDATA[$F{DETALLE_TIMBRES}]]></textFieldExpression></textField>
			<textField><reportElement x="764" y="0" width="38" height="14" uuid="b21f16fd-f435-41bd-8053-e0a0be03f94a"/><textElement textAlignment="Center"><font size="6"/></textElement><textFieldExpression><![CDATA[$F{ULTIMO_TIMBRE}]]></textFieldExpression></textField>
