<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reporte_ocho_horas_semanal" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c6bfcf43-4b9f-4e49-a4df-3bc762f4af59">
	<parameter name="pathImagen" class="java.lang.String"/>
	<parameter name="FechaDesde" class="java.lang.String"/>
	<parameter name="FechaHasta" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT q.no_persona,
       q.codigo,
       q.nombre_c,
       q.area_descrip,
       q.fecha,
       q.dia_semana,
       q.horario_trabajo,
       q.horario_almuerzo,
       q.hora_inicio,
       q.hora_fin,
       q.hora_fin AS ultimo_timbre,
       q.detalle_timbres,
       q.detalle_permisos,
       q.minutos_tarde,
       q.minutos_almuerzo_exceso,
       q.min_ultimo_timbre_hasta_salida,
       q.horas_trabajadas
  FROM (
        SELECT em.no_persona,
               TO_NUMBER(em.codigo) AS codigo,
               em.nombre_c,
               ar.descrip AS area_descrip,
               cal.fecha,
               cal.dia_semana,
               CASE
                 WHEN t.codigo IS NOT NULL THEN
                   LPAD(t.h_desde, 2, '0') || ':' || LPAD(t.mi_desde, 2, '0') || ' - ' ||
                   LPAD(t.h_hasta, 2, '0') || ':' || LPAD(t.mi_hasta, 2, '0')
                 ELSE
                   LPAD(TRUNC(NVL(ha.hora_inicio, 450) / 60), 2, '0') || ':' || LPAD(MOD(NVL(ha.hora_inicio, 450), 60), 2, '0') || ' - ' ||
                   LPAD(TRUNC(NVL(ha.hora_fin, 990) / 60), 2, '0') || ':' || LPAD(MOD(NVL(ha.hora_fin, 990), 60), 2, '0')
               END AS horario_trabajo,
               CASE
                 WHEN t.codigo IS NOT NULL THEN
                   CASE
                     WHEN t.h_desde >= 18 OR t.h_hasta < 6 THEN '01:00 - 02:00'
                     ELSE '13:00 - 14:00'
                   END
                 WHEN ha.inicio_almuerzo IS NOT NULL AND ha.fin_almuerzo IS NOT NULL THEN
                   LPAD(TRUNC(ha.inicio_almuerzo / 60), 2, '0') || ':' || LPAD(MOD(ha.inicio_almuerzo, 60), 2, '0') || ' - ' ||
                   LPAD(TRUNC(ha.fin_almuerzo / 60), 2, '0') || ':' || LPAD(MOD(ha.fin_almuerzo, 60), 2, '0')
                 ELSE 'NO DEFINIDO'
               END AS horario_almuerzo,
               NVL((
                 SELECT LISTAGG(
                          CASE
                            WHEN UPPER(v.descrip) LIKE '%VACACION%' THEN
                              v.descrip || ' [' || TO_CHAR(v.f_inico, 'DD/MM/YYYY HH24:MI') || ' - ' ||
                              TO_CHAR(NVL(v.f_finalizacion, v.f_inico), 'DD/MM/YYYY HH24:MI') || ']'
                            ELSE
                              v.descrip ||
                              CASE
                                WHEN TRUNC(v.f_inico) = TRUNC(NVL(v.f_finalizacion, v.f_inico)) THEN
                                  ' [' || TO_CHAR(v.f_inico, 'HH24:MI') || ' - ' ||
                                  TO_CHAR(NVL(v.f_finalizacion, v.f_inico), 'HH24:MI') || ']'
                                ELSE
                                  ' [' || TO_CHAR(v.f_inico, 'DD/MM/YYYY HH24:MI') || ' - ' ||
                                  TO_CHAR(NVL(v.f_finalizacion, v.f_inico), 'DD/MM/YYYY HH24:MI') || ']'
                              END
                          END,
                          ' | '
                        ) WITHIN GROUP (ORDER BY v.f_inico)
                   FROM permisos.v_permisos_empleado v
                  WHERE v.no_persona = em.no_persona
                    AND cal.fecha BETWEEN TRUNC(v.f_inico) AND TRUNC(NVL(v.f_finalizacion, v.f_inico))
               ), '-') AS detalle_permisos,
               NVL((
                 SELECT LISTAGG(
                          LPAD(r.hora, 2, '0') || ':' || LPAD(r.minuto, 2, '0') || '-' ||
                          CASE
                            WHEN UPPER(r.archivo) LIKE '%TELETIMBRADO%' THEN 'T'
                            WHEN UPPER(r.archivo) LIKE '%VIRTUAL%' THEN 'G'
                            ELSE 'B'
                          END,
                          ' | '
                        ) WITHIN GROUP (ORDER BY r.fecha, r.hora, r.minuto)
                   FROM rh.reloj r
                  WHERE r.codigo = em.codigo
                    AND (r.fecha = cal.fecha OR (t.h_hasta < 12 AND r.fecha = cal.fecha + 1))
               ), 'SIN TIMBRE') AS detalle_timbres,
               (
                 SELECT MIN(LPAD(r.hora, 2, '0') || ':' || LPAD(r.minuto, 2, '0'))
                   FROM rh.reloj r
                  WHERE r.codigo = em.codigo
                    AND r.fecha = cal.fecha
                    AND (r.hora * 60 + r.minuto) >= CASE WHEN t.codigo IS NOT NULL AND t.h_desde >= 12 THEN GREATEST(0, (t.h_desde * 60 + t.mi_desde) - 120) ELSE 0 END
               ) AS hora_inicio,
               (
                 SELECT MAX(LPAD(r.hora, 2, '0') || ':' || LPAD(r.minuto, 2, '0'))
                   FROM rh.reloj r
                  WHERE r.codigo = em.codigo
                    AND r.fecha = CASE WHEN t.codigo IS NOT NULL AND t.h_hasta < 12 THEN cal.fecha + 1 ELSE cal.fecha END
                    AND (r.hora * 60 + r.minuto) <= CASE WHEN t.codigo IS NOT NULL AND t.h_hasta < 12 THEN (t.h_hasta * 60 + t.mi_hasta) + 120 ELSE 1440 END
               ) AS hora_fin,
               CASE
                 WHEN t.codigo IS NOT NULL THEN
                   (
                     SELECT CASE
                              WHEN MIN(r.hora * 60 + r.minuto) IS NULL THEN 'SIN TIMBRE'
                              WHEN MIN(r.hora * 60 + r.minuto) <= (t.h_desde * 60 + t.mi_desde) THEN '0'
                              ELSE TO_CHAR(MIN(r.hora * 60 + r.minuto) - (t.h_desde * 60 + t.mi_desde))
                            END
                       FROM rh.reloj r
                      WHERE r.codigo = em.codigo
                        AND r.fecha = cal.fecha
                        AND (r.hora * 60 + r.minuto) >= CASE WHEN t.h_desde >= 12 THEN GREATEST(0, (t.h_desde * 60 + t.mi_desde) - 120) ELSE 0 END
                   )
                 ELSE
                   (
                     SELECT CASE
                              WHEN MIN(r.hora * 60 + r.minuto) IS NULL THEN 'SIN TIMBRE'
                              WHEN MIN(r.hora * 60 + r.minuto) <= NVL(ha.hora_inicio, 450) THEN '0'
                              ELSE TO_CHAR(MIN(r.hora * 60 + r.minuto) - NVL(ha.hora_inicio, 450))
                            END
                       FROM rh.reloj r
                      WHERE r.codigo = em.codigo
                        AND r.fecha = cal.fecha
                   )
               END AS minutos_tarde,
               CASE
                 WHEN t.codigo IS NOT NULL THEN
                   CASE
                     WHEN (
                       SELECT COUNT(*)
                         FROM rh.reloj r_total
                        WHERE r_total.codigo = em.codigo
                          AND r_total.fecha = cal.fecha
                     ) = 0 THEN 'SIN TIMBRES'
                     ELSE
                       (
                         SELECT CASE
                                  WHEN COUNT(*) < 2 THEN 'REGULARIZAR'
                                  WHEN (MAX(r.hora * 60 + r.minuto) - MIN(r.hora * 60 + r.minuto)) < 25 THEN 'TIEMPO DE ALMUERZO MENOR A 25 MINUTOS'
                                  WHEN (MAX(r.hora * 60 + r.minuto) - MIN(r.hora * 60 + r.minuto)) <= 60 THEN '0'
                                  ELSE TO_CHAR((MAX(r.hora * 60 + r.minuto) - MIN(r.hora * 60 + r.minuto)) - 60)
                                END
                           FROM rh.reloj r
                          WHERE r.codigo = em.codigo
                            AND r.fecha = cal.fecha
                            AND (r.hora * 60 + r.minuto) BETWEEN CASE WHEN t.h_desde >= 18 OR t.h_hasta < 6 THEN 60 ELSE 780 END
                                                            AND CASE WHEN t.h_desde >= 18 OR t.h_hasta < 6 THEN 120 ELSE 840 END
                       )
                   END
                 WHEN ha.inicio_almuerzo IS NULL OR ha.fin_almuerzo IS NULL THEN 'SIN HORARIO'
                 WHEN (
                   SELECT COUNT(*)
                     FROM rh.reloj r_total
                    WHERE r_total.codigo = em.codigo
                      AND r_total.fecha = cal.fecha
                 ) = 0 THEN 'SIN TIMBRES'
                 ELSE
                   (
                     SELECT CASE
                              WHEN COUNT(*) < 2 THEN 'REGULARIZAR'
                              WHEN (MAX(r.hora * 60 + r.minuto) - MIN(r.hora * 60 + r.minuto)) < 25 THEN 'TIEMPO DE ALMUERZO MENOR A 25 MINUTOS'
                              WHEN (MAX(r.hora * 60 + r.minuto) - MIN(r.hora * 60 + r.minuto)) <= NVL(ha.duracion_almuerzo, 60) THEN '0'
                              ELSE TO_CHAR((MAX(r.hora * 60 + r.minuto) - MIN(r.hora * 60 + r.minuto)) - NVL(ha.duracion_almuerzo, 60))
                            END
                       FROM rh.reloj r
                      WHERE r.codigo = em.codigo
                        AND r.fecha = cal.fecha
                        AND (r.hora * 60 + r.minuto) BETWEEN ha.inicio_almuerzo AND ha.fin_almuerzo
                   )
               END AS minutos_almuerzo_exceso,
               CASE
                 WHEN t.codigo IS NOT NULL THEN
                   (
                     SELECT CASE
                              WHEN MAX(r2.hora * 60 + r2.minuto) < (t.h_hasta * 60 + t.mi_hasta) THEN (t.h_hasta * 60 + t.mi_hasta) - MAX(r2.hora * 60 + r2.minuto)
                              ELSE 0
                            END
                       FROM rh.reloj r2
                      WHERE r2.codigo = em.codigo
                        AND r2.fecha = CASE WHEN t.h_hasta < 12 THEN cal.fecha + 1 ELSE cal.fecha END
                        AND (r2.hora * 60 + r2.minuto) <= CASE WHEN t.h_hasta < 12 THEN (t.h_hasta * 60 + t.mi_hasta) + 120 ELSE 1440 END
                   )
                 WHEN ha.hora_fin IS NULL THEN NULL
                 ELSE
                   (
                     SELECT CASE
                              WHEN MAX(r2.hora * 60 + r2.minuto) < NVL(ha.hora_fin, 990) THEN NVL(ha.hora_fin, 990) - MAX(r2.hora * 60 + r2.minuto)
                              ELSE 0
                            END
                       FROM rh.reloj r2
                      WHERE r2.codigo = em.codigo
                        AND r2.fecha = cal.fecha
                   )
               END AS min_ultimo_timbre_hasta_salida,
               ROUND(
                 GREATEST(
                   NVL((
                     SELECT MAX(
                              CASE
                                WHEN t.codigo IS NOT NULL AND t.h_hasta < 12 THEN (r.fecha - cal.fecha) * 1440 + r.hora * 60 + r.minuto
                                ELSE r.hora * 60 + r.minuto
                              END
                            )
                       FROM rh.reloj r
                      WHERE r.codigo = em.codigo
                        AND (r.fecha = cal.fecha OR (t.codigo IS NOT NULL AND t.h_hasta < 12 AND r.fecha = cal.fecha + 1))
                   ), 0)
                   -
                   NVL((
                     SELECT MIN(r.hora * 60 + r.minuto)
                       FROM rh.reloj r
                      WHERE r.codigo = em.codigo
                        AND r.fecha = cal.fecha
                   ), 0)
                   -
                   CASE WHEN t.codigo IS NOT NULL THEN 60 ELSE NVL(ha.duracion_almuerzo, 60) END,
                   0
                 ) / 60,
                 2
               ) AS horas_trabajadas
          FROM (
                SELECT e.no_persona,
                       e.nombre_c,
                       e.codigo,
                       e.email_institucional,
                       c.no_cd
                  FROM rh.t_dat_empleado e
                  JOIN rh.t_contrataciones c ON e.no_persona = c.no_persona
                 WHERE c.estado = 'V'
                   AND INSTR(e.email_institucional, '@geograficomilitar.gob.ec') > 0
               ) em
          LEFT JOIN inventarios.t_areas ar ON ar.no_cd = em.no_cd
          CROSS JOIN (
                SELECT TRUNC(TO_DATE($P{FechaDesde}, 'DD/MM/YYYY')) + LEVEL - 1 AS fecha,
                       TRIM(TO_CHAR(TRUNC(TO_DATE($P{FechaDesde}, 'DD/MM/YYYY')) + LEVEL - 1, 'DAY', 'NLS_DATE_LANGUAGE=SPANISH')) AS dia_semana
                  FROM dual
               CONNECT BY LEVEL <= TRUNC(TO_DATE($P{FechaHasta}, 'DD/MM/YYYY')) - TRUNC(TO_DATE($P{FechaDesde}, 'DD/MM/YYYY')) + 1
               ) cal
          LEFT JOIN rh.turnos t
            ON t.codigo = em.codigo
           AND cal.fecha BETWEEN t.f_desde AND t.f_hasta
          LEFT JOIN rh.horario_almuerzo ha
            ON ha.no_cd = em.no_cd
           AND (ha.dia_semana IS NULL OR UPPER(TRIM(ha.dia_semana)) = UPPER(TRIM(cal.dia_semana)))
           AND ha.activo = 'S'
           AND (ha.fecha_desde IS NULL OR cal.fecha >= ha.fecha_desde)
           AND (ha.fecha_hasta IS NULL OR cal.fecha <= ha.fecha_hasta)
       ) q
 WHERE q.horas_trabajadas > 0
   AND q.horas_trabajadas < 8
   AND q.detalle_permisos = '-'
 ORDER BY q.nombre_c, q.fecha]]>
	</queryString>
	<field name="NO_PERSONA" class="java.math.BigDecimal"/>
	<field name="CODIGO" class="java.math.BigDecimal"/>
	<field name="NOMBRE_C" class="java.lang.String"/>
	<field name="AREA_DESCRIP" class="java.lang.String"/>
	<field name="FECHA" class="java.sql.Timestamp"/>
	<field name="DIA_SEMANA" class="java.lang.String"/>
	<field name="HORARIO_TRABAJO" class="java.lang.String"/>
	<field name="HORARIO_ALMUERZO" class="java.lang.String"/>
	<field name="HORA_INICIO" class="java.lang.String"/>
	<field name="HORA_FIN" class="java.lang.String"/>
	<field name="ULTIMO_TIMBRE" class="java.lang.String"/>
	<field name="DETALLE_TIMBRES" class="java.lang.String"/>
	<field name="DETALLE_PERMISOS" class="java.lang.String"/>
	<field name="MINUTOS_TARDE" class="java.lang.String"/>
	<field name="MINUTOS_ALMUERZO_EXCESO" class="java.lang.String"/>
	<field name="MIN_ULTIMO_TIMBRE_HASTA_SALIDA" class="java.math.BigDecimal"/>
	<field name="HORAS_TRABAJADAS" class="java.math.BigDecimal"/>
