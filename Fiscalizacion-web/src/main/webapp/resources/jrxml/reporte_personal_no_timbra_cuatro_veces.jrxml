<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reporte_personal_no_timbra_cuatro_veces" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="66ee74c0-a05d-4beb-b055-1f4974b36552">
	<parameter name="pathImagen" class="java.lang.String"/>
	<parameter name="FechaDesde" class="java.lang.String"/>
	<parameter name="FechaHasta" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT q.codigo,
       q.no_persona,
       q.no_cedula,
       q.nombre_c,
       q.area_descrip,
       q.fecha,
       q.dia_semana,
       q.horario_trabajo,
       q.total_timbres,
       q.detalle_timbres
  FROM (
        SELECT e.codigo,
               e.no_persona,
               e.no_cedula,
               e.nombre_c,
               ar.descrip AS area_descrip,
               cal.fecha,
               cal.dia_semana,
               CASE
                 WHEN t.codigo IS NOT NULL THEN
                   LPAD(t.h_desde, 2, '0') || ':' || LPAD(t.mi_desde, 2, '0') || ' - ' ||
                   LPAD(t.h_hasta, 2, '0') || ':' || LPAD(t.mi_hasta, 2, '0')
                 ELSE
                   LPAD(TRUNC(NVL(ha.hora_inicio, 450) / 60), 2, '0') || ':' || LPAD(MOD(NVL(ha.hora_inicio, 450), 60), 2, '0') || ' - ' ||
                   LPAD(TRUNC(NVL(ha.hora_fin, 990) / 60), 2, '0') || ':' || LPAD(MOD(NVL(ha.hora_fin, 990), 60), 2, '0')
               END AS horario_trabajo,
               NVL((
                 SELECT COUNT(*)
                   FROM rh.reloj r
                  WHERE r.codigo = e.codigo
                    AND (
                         r.fecha = cal.fecha
                         OR (t.codigo IS NOT NULL AND t.h_hasta < 12 AND r.fecha = cal.fecha + 1)
                    )
               ), 0) AS total_timbres,
               NVL((
                 SELECT LISTAGG(
                          LPAD(r.hora, 2, '0') || ':' || LPAD(r.minuto, 2, '0') || '-' ||
                          CASE
                            WHEN UPPER(r.archivo) LIKE '%TELETIMBRADO%' THEN 'T'
                            WHEN UPPER(r.archivo) LIKE '%VIRTUAL%' THEN 'G'
                            ELSE 'B'
                          END,
                          ' | '
                        ) WITHIN GROUP (ORDER BY r.fecha, r.hora, r.minuto)
                   FROM rh.reloj r
                  WHERE r.codigo = e.codigo
                    AND (
                         r.fecha = cal.fecha
                         OR (t.codigo IS NOT NULL AND t.h_hasta < 12 AND r.fecha = cal.fecha + 1)
                    )
               ), 'SIN TIMBRE') AS detalle_timbres
          FROM rh.t_dat_empleado e
          JOIN rh.t_contrataciones c
            ON c.no_persona = e.no_persona
           AND c.estado = 'V'
          LEFT JOIN inventarios.t_areas ar
            ON ar.no_cd = c.no_cd
          CROSS JOIN (
                SELECT TRUNC(TO_DATE($P{FechaDesde}, 'DD/MM/YYYY')) + LEVEL - 1 AS fecha,
                       TRIM(TO_CHAR(TRUNC(TO_DATE($P{FechaDesde}, 'DD/MM/YYYY')) + LEVEL - 1, 'DAY', 'NLS_DATE_LANGUAGE=SPANISH')) AS dia_semana
                  FROM dual
               CONNECT BY LEVEL <= TRUNC(TO_DATE($P{FechaHasta}, 'DD/MM/YYYY')) - TRUNC(TO_DATE($P{FechaDesde}, 'DD/MM/YYYY')) + 1
               ) cal
          LEFT JOIN rh.turnos t
            ON t.codigo = e.codigo
           AND cal.fecha BETWEEN t.f_desde AND t.f_hasta
          LEFT JOIN rh.horario_almuerzo ha
            ON ha.no_cd = c.no_cd
           AND (ha.dia_semana IS NULL OR UPPER(TRIM(ha.dia_semana)) = UPPER(TRIM(cal.dia_semana)))
           AND ha.activo = 'S'
           AND (ha.fecha_desde IS NULL OR cal.fecha >= ha.fecha_desde)
           AND (ha.fecha_hasta IS NULL OR cal.fecha <= ha.fecha_hasta)
         WHERE e.codigo IS NOT NULL
           AND INSTR(e.email_institucional, '@geograficomilitar.gob.ec') > 0
           AND (
                t.codigo IS NOT NULL
                OR TO_CHAR(cal.fecha, 'DY', 'NLS_DATE_LANGUAGE=ENGLISH') NOT IN ('SAT', 'SUN')
           )
       ) q
 WHERE q.total_timbres < 4
 ORDER BY q.area_descrip, q.nombre_c, q.fecha]]>
	</queryString>
	<field name="CODIGO" class="java.lang.String"/>
	<field name="NO_PERSONA" class="java.math.BigDecimal"/>
	<field name="NO_CEDULA" class="java.lang.String"/>
