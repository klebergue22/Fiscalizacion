	<field name="HORA_INICIO" class="java.lang.String"/>
	<field name="MINUTOS_TARDE" class="java.math.BigDecimal"/>
	<field name="DETALLE_TIMBRES" class="java.lang.String"/>
	<field name="DETALLE_PERMISOS" class="java.lang.String"/>
