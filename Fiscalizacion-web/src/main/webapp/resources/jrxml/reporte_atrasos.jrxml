<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reporte_atrasos" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="d6f5f1f4-348e-4d95-90ec-dfcd2bf56047">
	<parameter name="pathImagen" class="java.lang.String"/>
	<parameter name="FechaDesde" class="java.lang.String"/>
	<parameter name="FechaHasta" class="java.lang.String"/>
	<parameter name="NoGestion" class="java.lang.Short"/>
	<queryString language="SQL">
		<![CDATA[SELECT q.codigo,
       q.nombre_c,
       q.area_descrip,
       q.fecha,
       q.dia_semana,
       q.horario_trabajo,
       q.hora_inicio,
       q.minutos_tarde,
       q.detalle_timbres,
       q.detalle_permisos
  FROM (
        SELECT em.codigo,
               em.nombre_c,
               ar.descrip AS area_descrip,
               cal.fecha,
               cal.dia_semana,
               CASE
                 WHEN t.codigo IS NOT NULL THEN
                   LPAD(t.h_desde, 2, '0') || ':' || LPAD(t.mi_desde, 2, '0') || ' - ' ||
                   LPAD(t.h_hasta, 2, '0') || ':' || LPAD(t.mi_hasta, 2, '0')
                 ELSE
                   LPAD(TRUNC(NVL(ha.hora_inicio, 450) / 60), 2, '0') || ':' || LPAD(MOD(NVL(ha.hora_inicio, 450), 60), 2, '0') || ' - ' ||
                   LPAD(TRUNC(NVL(ha.hora_fin, 990) / 60), 2, '0') || ':' || LPAD(MOD(NVL(ha.hora_fin, 990), 60), 2, '0')
               END AS horario_trabajo,
               (
                 SELECT MIN(LPAD(r.hora, 2, '0') || ':' || LPAD(r.minuto, 2, '0'))
                   FROM rh.reloj r
                  WHERE r.codigo = em.codigo
                    AND r.fecha = cal.fecha
                    AND (r.hora * 60 + r.minuto) >= CASE WHEN t.codigo IS NOT NULL AND t.h_desde >= 12 THEN GREATEST(0, (t.h_desde * 60 + t.mi_desde) - 120) ELSE 0 END
               ) AS hora_inicio,
               CASE
                 WHEN t.codigo IS NOT NULL THEN
                   (
                     SELECT CASE
                              WHEN MIN(r.hora * 60 + r.minuto) IS NULL THEN 0
                              WHEN MIN(r.hora * 60 + r.minuto) <= (t.h_desde * 60 + t.mi_desde) THEN 0
                              ELSE MIN(r.hora * 60 + r.minuto) - (t.h_desde * 60 + t.mi_desde)
                            END
                       FROM rh.reloj r
                      WHERE r.codigo = em.codigo
                        AND r.fecha = cal.fecha
                        AND (r.hora * 60 + r.minuto) >= CASE WHEN t.h_desde >= 12 THEN GREATEST(0, (t.h_desde * 60 + t.mi_desde) - 120) ELSE 0 END
                   )
                 ELSE
                   (
                     SELECT CASE
                              WHEN MIN(r.hora * 60 + r.minuto) IS NULL THEN 0
                              WHEN MIN(r.hora * 60 + r.minuto) <= NVL(ha.hora_inicio, 450) THEN 0
                              ELSE MIN(r.hora * 60 + r.minuto) - NVL(ha.hora_inicio, 450)
                            END
                       FROM rh.reloj r
                      WHERE r.codigo = em.codigo
                        AND r.fecha = cal.fecha
                   )
               END AS minutos_tarde,
               NVL((
                 SELECT LISTAGG(LPAD(r.hora, 2, '0') || ':' || LPAD(r.minuto, 2, '0'), ' | ')
                        WITHIN GROUP (ORDER BY r.fecha, r.hora, r.minuto)
                   FROM rh.reloj r
                  WHERE r.codigo = em.codigo
                    AND r.fecha = cal.fecha
               ), 'SIN TIMBRE') AS detalle_timbres,
               NVL((
                 SELECT LISTAGG(v.descrip || ' [' || TO_CHAR(v.f_inico, 'HH24:MI') || ' - ' || TO_CHAR(NVL(v.f_finalizacion, v.f_inico), 'HH24:MI') || ']', ' | ')
                        WITHIN GROUP (ORDER BY v.f_inico)
                   FROM permisos.v_permisos_empleado v
                  WHERE v.no_persona = em.no_persona
                    AND cal.fecha BETWEEN TRUNC(v.f_inico) AND TRUNC(NVL(v.f_finalizacion, v.f_inico))
               ), '-') AS detalle_permisos
          FROM (
                SELECT e.no_persona,
                       e.nombre_c,
                       e.codigo,
                       c.no_cd
                  FROM rh.t_dat_empleado e
                  JOIN rh.t_contrataciones c ON e.no_persona = c.no_persona
                 WHERE c.estado = 'V'
                   AND ($P{NoGestion} = 0 OR c.no_cd = $P{NoGestion})
                ) em
          LEFT JOIN inventarios.t_areas ar ON ar.no_cd = em.no_cd
          CROSS JOIN (
                SELECT TRUNC(TO_DATE($P{FechaDesde}, 'DD/MM/YYYY')) + LEVEL - 1 AS fecha,
                       TRIM(TO_CHAR(TRUNC(TO_DATE($P{FechaDesde}, 'DD/MM/YYYY')) + LEVEL - 1, 'DAY', 'NLS_DATE_LANGUAGE=SPANISH')) AS dia_semana
                  FROM dual
               CONNECT BY LEVEL <= TRUNC(TO_DATE($P{FechaHasta}, 'DD/MM/YYYY')) - TRUNC(TO_DATE($P{FechaDesde}, 'DD/MM/YYYY')) + 1
               ) cal
          LEFT JOIN rh.turnos t
            ON t.codigo = em.codigo
           AND cal.fecha BETWEEN t.f_desde AND t.f_hasta
          LEFT JOIN rh.horario_almuerzo ha
            ON ha.no_cd = em.no_cd
           AND (ha.dia_semana IS NULL OR UPPER(TRIM(ha.dia_semana)) = UPPER(TRIM(cal.dia_semana)))
           AND ha.activo = 'S'
           AND (ha.fecha_desde IS NULL OR cal.fecha >= ha.fecha_desde)
           AND (ha.fecha_hasta IS NULL OR cal.fecha <= ha.fecha_hasta)
       ) q
 WHERE q.minutos_tarde > 0
 ORDER BY q.area_descrip, q.nombre_c, q.fecha]]>
	</queryString>
